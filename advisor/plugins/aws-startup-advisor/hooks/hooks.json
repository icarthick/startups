{
  "description": "Ambient startup context, and migration-telemetry session teardown",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat ${CLAUDE_PLUGIN_ROOT}/scripts/startup-context.txt",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/telemetry/emit.mjs", "--session-end"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
