{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node ./hooks/telemetry/emit.mjs --skill GCP_TO_AWS --reconcile",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "node ./hooks/telemetry/emit.mjs --skill GCP_TO_AWS --reconcile",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "node ./hooks/telemetry/emit.mjs --session-end",
        "timeout": 10
      }
    ]
  }
}
