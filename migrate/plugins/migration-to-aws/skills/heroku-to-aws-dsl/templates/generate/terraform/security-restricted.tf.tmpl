# Security — RESTRICTED (a Private Space exists). Selected by the routing when the
# design has a Private Space. Defines the SAME per-tier SGs the domain templates
# reference (alb/fargate/database/cache/messaging) so HCL references resolve, BUT
# the ALB (external) ingress is restricted to the declared Private-Space
# dependency CIDRs (var.app_ingress_rules) instead of 0.0.0.0/0. Inter-tier SGs
# (fargate<-alb, db/cache/msk<-fargate) are unchanged from standard.
# {{vpc_id_reference}} = aws_vpc.main.id (new) or data.aws_vpc.existing.id (existing).
# Only emit a tier's SG when that service type is present in the design.

variable "app_ingress_rules" {
  description = "Restricted external ingress rules from Private Space dependencies (from aws-design.json vpc_design.security_groups[].inbound_rules)"
  type = list(object({
    port        = number
    protocol    = string
    cidr        = string
    description = string
  }))
  default = {{app_ingress_rules_hcl}}
}

# ALB SG — RESTRICTED external ingress (declared dependency CIDRs only, not 0.0.0.0/0)
resource "aws_security_group" "alb" {
  name_prefix = "${var.project_name}-${var.environment}-alb-"
  vpc_id      = {{vpc_id_reference}}
  description = "ALB security group (Private Space: restricted ingress)"

  dynamic "ingress" {
    for_each = var.app_ingress_rules
    content {
      from_port   = ingress.value.port
      to_port     = ingress.value.port
      protocol    = ingress.value.protocol
      cidr_blocks = [ingress.value.cidr]
      description = ingress.value.description
    }
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow all outbound"
  }
  tags = { Name = "${var.project_name}-${var.environment}-alb-sg" }
  lifecycle { create_before_destroy = true }
}

# Fargate task SG (emit when Fargate in design) — from ALB SG only
resource "aws_security_group" "fargate" {
  name_prefix = "${var.project_name}-${var.environment}-fargate-"
  vpc_id      = {{vpc_id_reference}}
  description = "Security group for Fargate tasks"

  ingress {
    from_port       = 0
    to_port         = 65535
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
    description     = "Traffic from ALB"
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow all outbound"
  }
  tags = { Name = "${var.project_name}-${var.environment}-fargate-sg" }
  lifecycle { create_before_destroy = true }
}

# Database SG (emit when RDS/Aurora in design) — from Fargate SG only
resource "aws_security_group" "database" {
