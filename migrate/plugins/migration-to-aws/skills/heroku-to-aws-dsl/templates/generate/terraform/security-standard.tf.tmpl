# Security — STANDARD (no Private Space). Selected by the routing when no space.
# Per-tier SGs; only emit blocks for services present in the design. Fargate SG
# allows from ALB SG only; DB/cache/MSK from Fargate SG only.
# {{vpc_id_reference}} = aws_vpc.main.id (new) or data.aws_vpc.existing.id (existing).

# ALB SG (emit when ALB/Fargate web in design)
resource "aws_security_group" "alb" {
  name_prefix = "${var.project_name}-${var.environment}-alb-"
  vpc_id      = {{vpc_id_reference}}
  description = "Security group for Application Load Balancer"

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "HTTPS from internet"
  }
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "HTTP from internet (redirects to HTTPS)"
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow all outbound"
  }
  tags = { Name = "${var.project_name}-${var.environment}-alb-sg" }
  lifecycle { create_before_destroy = true }
}

# Fargate task SG (emit when Fargate in design)
resource "aws_security_group" "fargate" {
  name_prefix = "${var.project_name}-${var.environment}-fargate-"
  vpc_id      = {{vpc_id_reference}}
  description = "Security group for Fargate tasks"

  ingress {
    from_port       = 0
    to_port         = 65535
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
    description     = "Traffic from ALB"
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow all outbound"
  }
  tags = { Name = "${var.project_name}-${var.environment}-fargate-sg" }
  lifecycle { create_before_destroy = true }
}

