{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "feedback-trace.schema.json",
  "title": "Anonymized Feedback Trace",
  "description": "Anonymized telemetry trace built from migration artifacts. MUST NOT contain resource names, file paths, account IDs, or secrets — only counts/types/enums. Only includes sections for artifacts that exist.",
  "type": "object",
  "required": ["migration_id", "skill", "phases_completed"],
  "additionalProperties": true,
  "properties": {
    "migration_id": { "type": "string" },
    "skill": { "type": "string" },
    "phases_completed": { "type": "array", "items": { "type": "string" } },
    "discovery": {
      "type": "object",
      "properties": {
        "total_apps": { "type": "integer", "minimum": 0 },
        "total_resources": { "type": "integer", "minimum": 0 },
        "resource_type_counts": { "type": "object" },
        "discovery_sources": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "string" }
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "questions_asked_count": { "type": "integer", "minimum": 0 },
        "questions_defaulted_count": { "type": "integer", "minimum": 0 }
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "total_services": { "type": "integer", "minimum": 0 },
        "deferred_count": { "type": "integer", "minimum": 0 },
        "warnings_count": { "type": "integer", "minimum": 0 }
      }
    },
    "estimation": {
      "type": "object",
      "properties": {
        "pricing_source": { "type": "string" },
        "projected_monthly": { "type": ["number", "null"] }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "terraform_file_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["resource_names"] },
      { "required": ["account_id"] },
      { "required": ["file_paths"] }
    ]
  }
}
