{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "preferences.schema.json",
  "title": "Heroku-to-AWS Migration Preferences",
  "description": "Interpreted clarify-phase answers, consumed directly by Design and Estimate. Conditional sections/keys (data HA fields, network peering, Fir intent) are OMITTED when the triggering resource is absent — only keys with non-null values are present.",
  "type": "object",
  "required": ["metadata", "global", "operational", "design_constraints", "sources"],
  "additionalProperties": true,
  "properties": {
    "migration_id": { "type": "string" },
    "skill": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["clarify_mode"],
      "properties": {
        "timestamp": { "type": "string" },
        "clarify_mode": { "type": "string", "enum": ["full", "fast_path"] },
        "questions_asked": { "type": "array", "items": { "type": "string" } },
        "questions_defaulted": { "type": "array", "items": { "type": "string" } },
        "questions_skipped_not_applicable": { "type": "array", "items": { "type": "string" } }
      },
      "not": {
        "anyOf": [
          { "required": ["draft"] },
          { "required": ["batches_completed"] },
          { "required": ["batches_remaining"] }
        ]
      }
    },
    "global": {
      "type": "object",
      "required": ["target_region", "availability"],
      "properties": {
        "target_region": { "type": "string", "minLength": 1 },
        "compliance": {
          "oneOf": [
            { "type": "string", "enum": ["none", "soc2", "hipaa", "pci"] },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "availability": { "type": "string", "enum": ["single-az", "multi-az", "multi-az-ha", "multi-region"] },
        "maintenance_window": {
          "oneOf": [
            { "type": "string", "enum": ["flexible"] },
            {
              "type": "object",
              "required": ["day", "hour_utc"],
              "properties": {
                "day": { "type": "string" },
                "hour_utc": { "type": "integer", "minimum": 0, "maximum": 23 }
              }
            }
          ]
        },
        "environment_naming": { "type": "string", "minLength": 1 },
        "migration_approach": { "type": "string", "enum": ["full_cutover", "interim_cutover_data_first"] },
        "interim_cutover": { "type": "boolean" },
        "target_exit_date": { "type": "string", "minLength": 1 },
        "ktlo_warning": { "type": "string" },
        "fir_intent": { "type": "string", "enum": ["exit_heroku", "self_managed_eks_ecs"] }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "database_ha": { "type": "string", "enum": ["single-az", "multi-az", "multi-az-ha", "multi-region"] },
        "migration_method": { "type": "string", "enum": ["pg_dump_restore", "dms", "bucardo", "wal_g"] },
        "estimated_db_size_gb": { "type": ["number", "string"] },
        "db_size_source": { "type": "string", "enum": ["plan_derived", "user_override"] },
        "redis_ha": { "type": "boolean" },
        "kafka_retention_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "dns_strategy": { "type": "string", "enum": ["route53", "external"] }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "existing_vpc_id": { "type": "string", "pattern": "^vpc-[0-9a-f]{17}$" },
        "subnet_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^subnet-[0-9a-f]{17}$" }
        },
        "private_space_detected": { "type": "boolean" }
      }
    },
    "operational": {
      "type": "object",
      "required": ["containerization_status"],
      "properties": {
        "container_registry": { "type": "string", "enum": ["ecr", "external"] },
        "containerization_status": { "type": "string", "enum": ["containerized", "buildpack_only", "partial"] },
        "log_retention_days": { "type": "integer", "minimum": 1, "maximum": 3653 },
        "alerting": { "type": "string", "enum": ["cloudwatch", "pagerduty", "opsgenie", "none"] },
        "cost_optimization": { "type": "string", "enum": ["conservative", "balanced", "aggressive"] }
      }
    },
    "design_constraints": {
      "type": "object",
      "required": ["kubernetes"],
      "properties": {
        "kubernetes": {
          "type": "object",
          "required": ["value", "chosen_by"],
          "properties": {
            "value": { "type": "string", "enum": ["eks-managed", "eks-or-ecs", "ecs-fargate"] },
            "chosen_by": { "type": "string", "enum": ["user", "default"] }
          }
        }
      }
    },
    "defaults_applied": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "enum": ["user", "default"] }
    }
  }
}
