{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eliminators.json",
  "title": "Eliminators Schema",
  "description": "Validates universal eliminator rules (hard feature blockers).",
  "allOf": [{ "$ref": "knowledge-envelope.json" }],
  "properties": {
    "kind": { "const": "eliminators" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "excludes": { "type": "string" },
          "forbids": { "type": "string" },
          "fallback": { "type": "string" },
          "when": {
            "oneOf": [
              { "const": "always" },
              {
                "type": "object",
                "properties": {
                  "field": { "type": "string" },
                  "op": { "type": "string", "enum": ["==", "!=", ">", "<", ">=", "<="] },
                  "value": {}
                },
                "required": ["field", "op", "value"]
              },
              {
                "type": "object",
                "properties": {
                  "any": { "type": "array" },
                  "all": { "type": "array" }
                }
              }
            ]
          },
          "reason": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "last_verified": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    }
  }
}
