{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skip-mappings.json",
  "title": "Skip Mappings Schema",
  "description": "Validates source-scoped skip-mapping knowledge files (resources with no AWS equivalent).",
  "allOf": [{ "$ref": "knowledge-envelope.json" }],
  "properties": {
    "kind": { "const": "skip-mappings" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "reason"],
        "properties": {
          "source_type": { "type": "string" },
          "reason": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
