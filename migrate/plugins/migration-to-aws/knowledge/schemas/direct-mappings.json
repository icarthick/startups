{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "direct-mappings.json",
  "title": "Direct Mappings Schema",
  "description": "Validates source-scoped direct-mapping knowledge files (Pass 1 fast-path).",
  "allOf": [{ "$ref": "knowledge-envelope.json" }],
  "properties": {
    "kind": { "const": "direct-mappings" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "condition", "aws_service", "confidence"],
        "properties": {
          "source_type": { "type": "string" },
          "condition": {
            "oneOf": [
              { "const": "always" },
              { "type": "object", "minProperties": 1 }
            ]
          },
          "aws_service": { "type": "string" },
          "confidence": { "const": "deterministic" },
          "notes": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "last_verified": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    }
  }
}
