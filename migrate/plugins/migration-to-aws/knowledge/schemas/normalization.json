{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalization.json",
  "title": "Normalization Schema",
  "description": "Validates source-scoped normalization files (source → canonical model).",
  "allOf": [{ "$ref": "knowledge-envelope.json" }],
  "properties": {
    "kind": { "const": "normalization" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "canonical_workload", "field_map"],
        "properties": {
          "source_type": { "type": "string" },
          "canonical_workload": { "type": "string" },
          "field_map": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["from"],
                  "properties": {
                    "from": { "type": "string" },
                    "transform": { "type": "object" }
                  }
                },
                { "type": "number" },
                { "type": "boolean" }
              ]
            }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
