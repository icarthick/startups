{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vocabulary.json",
  "title": "Vocabulary Schema",
  "description": "Validates universal vocabulary files (key → user-facing label + hint).",
  "allOf": [{ "$ref": "knowledge-envelope.json" }],
  "properties": {
    "kind": { "const": "vocabulary" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "hint": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
