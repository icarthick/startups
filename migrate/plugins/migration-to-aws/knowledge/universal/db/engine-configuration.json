{
  "kind": "engine-configuration",
  "scope": "universal",
  "version": "1",
  "description": "Complete configuration registry per database engine × family. Expresses all valid combinations of instance classes, storage types, replica support, and serverless availability. Invalid combinations are impossible by omission.",
  "last_verified": "2026-06-14",
  "source_url": "https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/Concepts.DBInstanceClass.html",
  "entries": {
    "postgres": {
      "aws_service_suffix": "PostgreSQL",
      "terraform_engine": "postgres",
      "families": {
        "RDS": {
          "instance_classes": {
            "micro": "db.t4g.micro",
            "small": "db.t4g.small",
            "medium": "db.t4g.medium",
            "large": "db.r6g.large",
            "xlarge": "db.r6g.xlarge"
          },
          "storage_types": {
            "low": "gp3",
            "medium": "gp3",
            "high": "io2"
          },
          "supports_read_replica": true,
          "supports_serverless_v2": false,
          "traffic_scaling": {
            "steady": { "add_replica": false, "sizing_hint": "standard" },
            "read-heavy": { "add_replica": true, "replica_type": "read-replica", "sizing_hint": "standard" },
            "write-heavy": { "add_replica": false, "sizing_hint": "scale-up" },
            "spiky": { "add_replica": false, "sizing_hint": "burstable" }
          }
        },
        "Aurora": {
          "instance_classes": {
            "micro": "db.t4g.micro",
            "small": "db.t4g.small",
            "medium": "db.r6g.medium",
            "large": "db.r6g.large",
            "xlarge": "db.r6g.xlarge"
          },
          "storage_types": {
            "low": "standard",
            "medium": "standard",
            "high": "io-optimized"
          },
          "supports_read_replica": true,
          "supports_serverless_v2": true,
          "serverless_v2": {
            "acu_ranges": {
              "micro": { "min": 0.5, "max": 2 },
              "small": { "min": 0.5, "max": 4 },
              "medium": { "min": 1, "max": 16 },
              "large": { "min": 2, "max": 64 },
              "xlarge": { "min": 4, "max": 128 }
            }
          },
          "traffic_scaling": {
            "steady": { "add_replica": false, "sizing_hint": "standard" },
            "read-heavy": { "add_replica": true, "replica_type": "aurora-reader", "sizing_hint": "standard" },
            "write-heavy": { "add_replica": false, "sizing_hint": "scale-up", "notes": "If multi-region, consider Aurora DSQL" },
            "spiky": { "add_replica": false, "serverless_v2": true, "sizing_hint": "serverless" }
          }
        }
      }
    },
    "mysql": {
      "aws_service_suffix": "MySQL",
      "terraform_engine": "mysql",
      "families": {
        "RDS": {
          "instance_classes": {
            "micro": "db.t4g.micro",
            "small": "db.t4g.small",
            "medium": "db.t4g.medium",
            "large": "db.r6g.large",
            "xlarge": "db.r6g.xlarge"
          },
          "storage_types": {
            "low": "gp3",
            "medium": "gp3",
            "high": "io2"
          },
          "supports_read_replica": true,
          "supports_serverless_v2": false,
          "traffic_scaling": {
            "steady": { "add_replica": false, "sizing_hint": "standard" },
            "read-heavy": { "add_replica": true, "replica_type": "read-replica", "sizing_hint": "standard" },
            "write-heavy": { "add_replica": false, "sizing_hint": "scale-up" },
            "spiky": { "add_replica": false, "sizing_hint": "burstable" }
          }
        },
        "Aurora": {
          "instance_classes": {
            "micro": "db.t4g.micro",
            "small": "db.t4g.small",
            "medium": "db.r6g.medium",
            "large": "db.r6g.large",
            "xlarge": "db.r6g.xlarge"
          },
          "storage_types": {
            "low": "standard",
            "medium": "standard",
            "high": "io-optimized"
          },
          "supports_read_replica": true,
          "supports_serverless_v2": true,
          "serverless_v2": {
            "acu_ranges": {
              "micro": { "min": 0.5, "max": 2 },
              "small": { "min": 0.5, "max": 4 },
              "medium": { "min": 1, "max": 16 },
              "large": { "min": 2, "max": 64 },
              "xlarge": { "min": 4, "max": 128 }
            }
          },
          "traffic_scaling": {
            "steady": { "add_replica": false, "sizing_hint": "standard" },
            "read-heavy": { "add_replica": true, "replica_type": "aurora-reader", "sizing_hint": "standard" },
            "write-heavy": { "add_replica": false, "sizing_hint": "scale-up", "notes": "If multi-region, consider Aurora DSQL" },
            "spiky": { "add_replica": false, "serverless_v2": true, "sizing_hint": "serverless" }
          }
        }
      }
    },
    "sqlserver": {
      "aws_service_suffix": "SQL Server",
      "terraform_engine": "sqlserver-se",
      "families": {
        "RDS": {
          "instance_classes": {
            "micro": "db.t3.micro",
            "small": "db.t3.small",
            "medium": "db.t3.medium",
            "large": "db.r5.large",
            "xlarge": "db.r5.xlarge"
          },
          "storage_types": {
            "low": "gp3",
            "medium": "gp3",
            "high": "io2"
          },
          "supports_read_replica": false,
          "supports_serverless_v2": false,
          "traffic_scaling": {
            "steady": { "add_replica": false, "sizing_hint": "standard" },
            "read-heavy": { "add_replica": false, "sizing_hint": "scale-up", "notes": "No read replica for SQL Server; scale vertically or use Always On AG via Multi-AZ" },
            "write-heavy": { "add_replica": false, "sizing_hint": "scale-up" },
            "spiky": { "add_replica": false, "sizing_hint": "burstable" }
          },
          "notes": "No Graviton/ARM support. No Aurora. No read replicas (use Multi-AZ for HA)."
        }
      }
    },
    "mariadb": {
      "aws_service_suffix": "MariaDB",
      "terraform_engine": "mariadb",
      "needs_user_confirmation": true,
      "confirmation_reason": "MariaDB and MySQL have diverged (10.6+). User may prefer MySQL for ecosystem.",
      "alternative_engine": "mysql",
      "families": {
        "RDS": {
          "instance_classes": {
            "micro": "db.t4g.micro",
            "small": "db.t4g.small",
            "medium": "db.t4g.medium",
            "large": "db.r6g.large",
            "xlarge": "db.r6g.xlarge"
          },
          "storage_types": {
            "low": "gp3",
            "medium": "gp3",
            "high": "io2"
          },
          "supports_read_replica": true,
          "supports_serverless_v2": false,
          "traffic_scaling": {
            "steady": { "add_replica": false, "sizing_hint": "standard" },
            "read-heavy": { "add_replica": true, "replica_type": "read-replica", "sizing_hint": "standard" },
            "write-heavy": { "add_replica": false, "sizing_hint": "scale-up" },
            "spiky": { "add_replica": false, "sizing_hint": "burstable" }
          }
        }
      }
    },
    "oracle": {
      "aws_service_suffix": "Oracle",
      "terraform_engine": "oracle-ee",
      "needs_user_confirmation": true,
      "confirmation_reason": "Many migrations want to escape Oracle licensing → Aurora PostgreSQL. Requires schema conversion (AWS SCT).",
      "escape_path": { "target_engine": "postgres", "target_family": "Aurora", "tool": "AWS SCT" },
      "families": {
        "RDS": {
          "instance_classes": {
            "medium": "db.r5.large",
            "large": "db.r5.xlarge",
            "xlarge": "db.r5.2xlarge"
          },
          "storage_types": {
            "low": "gp3",
            "medium": "gp3",
            "high": "io2"
          },
          "supports_read_replica": true,
          "supports_serverless_v2": false,
          "traffic_scaling": {
            "steady": { "add_replica": false, "sizing_hint": "standard" },
            "read-heavy": { "add_replica": true, "replica_type": "read-replica", "sizing_hint": "standard" },
            "write-heavy": { "add_replica": false, "sizing_hint": "scale-up" },
            "spiky": { "add_replica": false, "sizing_hint": "standard", "notes": "No burstable instances for Oracle" }
          },
          "notes": "No Graviton/ARM. No burstable (t-class). No Aurora. License cost baked into instance pricing."
        }
      }
    }
  }
}
