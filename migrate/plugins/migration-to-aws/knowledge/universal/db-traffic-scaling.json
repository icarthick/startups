{
  "kind": "decision-matrix",
  "scope": "universal",
  "version": "1",
  "description": "Maps traffic pattern (Q12) + database family to replica and scaling decisions. Family-aware because Serverless v2 is Aurora-only and replica mechanics differ between RDS (async read replica) and Aurora (shared-storage reader).",
  "last_verified": "2026-06-14",
  "source_url": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-serverless-v2.html",
  "selector": "traffic",
  "matrix": {
    "steady": {
      "RDS": { "add_replica": false, "serverless_v2": false, "sizing_hint": "standard" },
      "Aurora": { "add_replica": false, "serverless_v2": false, "sizing_hint": "standard" }
    },
    "read-heavy": {
      "RDS": { "add_replica": true, "replica_type": "read-replica", "serverless_v2": false, "sizing_hint": "standard" },
      "Aurora": { "add_replica": true, "replica_type": "aurora-reader", "serverless_v2": false, "sizing_hint": "standard" }
    },
    "write-heavy": {
      "RDS": { "add_replica": false, "serverless_v2": false, "sizing_hint": "scale-up" },
      "Aurora": { "add_replica": false, "serverless_v2": false, "sizing_hint": "scale-up", "notes": "If multi-region topology, consider Aurora DSQL for distributed writes" }
    },
    "spiky": {
      "RDS": { "add_replica": false, "serverless_v2": false, "sizing_hint": "burstable", "notes": "Use burstable instance (db.t4g.*); Serverless v2 not available on RDS" },
      "Aurora": { "add_replica": false, "serverless_v2": true, "sizing_hint": "serverless", "notes": "Aurora Serverless v2 scales to zero; ideal for unpredictable traffic" }
    }
  },
  "absent_behavior": "use_default",
  "entries": []
}
