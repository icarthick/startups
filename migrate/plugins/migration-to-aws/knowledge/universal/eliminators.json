{
  "kind": "eliminators",
  "scope": "universal",
  "version": "1",
  "description": "Hard feature blockers that eliminate an AWS service from consideration. Evaluated before any rubric or preference.",
  "last_verified": "2026-06-14",
  "entries": [
    {
      "id": "lambda-15min",
      "excludes": "Lambda",
      "fallback": "Fargate",
      "when": { "field": "timeout_seconds", "op": ">", "value": 900 },
      "reason": "Lambda max execution time is 15 minutes (900s)"
    },
    {
      "id": "fargate-vcpu-limit",
      "excludes": "Fargate",
      "fallback": "EC2",
      "when": { "field": "vcpu", "op": ">", "value": 16 },
      "reason": "Fargate max 16 vCPU per task"
    },
    {
      "id": "fargate-memory-limit",
      "excludes": "Fargate",
      "fallback": "EC2",
      "when": { "field": "memory_gb", "op": ">", "value": 120 },
      "reason": "Fargate max 120 GB memory per task"
    },
    {
      "id": "fargate-gpu",
      "excludes": "Fargate",
      "fallback": "EC2",
      "when": { "field": "gpu", "op": "==", "value": true },
      "reason": "Fargate does not support GPU workloads"
    },
    {
      "id": "apprunner-closed",
      "forbids": "App Runner",
      "when": "always",
      "reason": "App Runner closed to new customers April 30, 2026",
      "last_verified": "2026-06-14",
      "source_url": "https://aws.amazon.com/app-runner/"
    },
    {
      "id": "dynamodb-txn-limit",
      "excludes": "DynamoDB",
      "fallback": "RDS",
      "when": { "field": "txn_items_required", "op": ">", "value": 100 },
      "reason": "DynamoDB transaction limit: 100 items per transaction"
    }
  ]
}
