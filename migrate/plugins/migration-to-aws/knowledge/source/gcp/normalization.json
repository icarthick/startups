{
  "kind": "normalization",
  "scope": "source:gcp",
  "version": "1",
  "description": "Maps GCP Terraform resource types to canonical workload models consumed by decide tools.",
  "last_verified": "2026-06-14",
  "entries": [
    {
      "source_type": "google_sql_database_instance",
      "archetype": "relational-db",
      "field_map": {
        "engine": {
          "from": "database_version",
          "transform": { "POSTGRES_*": "postgres", "MYSQL_*": "mysql", "SQLSERVER_*": "sqlserver" }
        },
        "availability": {
          "from": "settings.availability_type",
          "transform": { "ZONAL": "single-az", "REGIONAL": "multi-az" }
        },
        "size_class": {
          "from": "settings.tier",
          "transform": { "db-f1-micro": "micro", "db-g1-small": "small", "db-custom-*": "medium" }
        }
      },
      "notes": "multi-az-ha and multi-region are never inferred from IaC — require Q6 user answer"
    },
    {
      "source_type": "google_cloud_run_service",
      "archetype": "container",
      "field_map": {
        "service_type": "container",
        "timeout_seconds": { "from": "template.spec.timeout_seconds", "transform": {} },
        "memory_gb": { "from": "template.spec.containers[0].resources.limits.memory", "transform": {} },
        "vcpu": { "from": "template.spec.containers[0].resources.limits.cpu", "transform": {} }
      }
    },
    {
      "source_type": "google_cloud_run_v2_service",
      "archetype": "container",
      "field_map": {
        "service_type": "container",
        "timeout_seconds": { "from": "template.timeout", "transform": {} },
        "memory_gb": { "from": "template.containers[0].resources.limits.memory", "transform": {} },
        "vcpu": { "from": "template.containers[0].resources.limits.cpu", "transform": {} }
      },
      "notes": "v2 API uses slightly different config paths than v1"
    },
    {
      "source_type": "google_cloudfunctions_function",
      "archetype": "function",
      "field_map": {
        "service_type": "function",
        "timeout_seconds": { "from": "timeout", "transform": {} },
        "memory_gb": {
          "from": "available_memory_mb",
          "transform": { "128": 0.125, "256": 0.25, "512": 0.5, "1024": 1, "2048": 2, "4096": 4, "8192": 8 }
        },
        "runtime": { "from": "runtime", "transform": {} }
      },
      "notes": "Gen 1 Cloud Functions. Memory in MB → converted to GB for canonical model."
    },
    {
      "source_type": "google_cloudfunctions2_function",
      "archetype": "function",
      "field_map": {
        "service_type": "function",
        "timeout_seconds": { "from": "build_config.service_config.timeout_seconds", "transform": {} },
        "memory_gb": { "from": "build_config.service_config.available_memory", "transform": {} },
        "runtime": { "from": "build_config.runtime", "transform": {} },
        "vcpu": { "from": "build_config.service_config.available_cpu", "transform": {} }
      },
      "notes": "Gen 2 Cloud Functions (built on Cloud Run). Paths differ from Gen 1."
    },
    {
      "source_type": "google_app_engine_application",
      "archetype": "container",
      "field_map": {
        "service_type": "container"
      },
      "notes": "App Engine workloads are containerized web apps. Classify as container archetype."
    },
    {
      "source_type": "google_compute_instance",
      "archetype": "vm",
      "field_map": {
        "service_type": "vm",
        "vcpu": {
          "from": "machine_type",
          "transform": { "__gcp_machine_type__": "vcpu" }
        },
        "memory_gb": {
          "from": "machine_type",
          "transform": { "__gcp_machine_type__": "memory_gb" }
        },
        "gpu": { "from": "guest_accelerator", "transform": { "present": true, "absent": false } }
      }
    },
    {
      "source_type": "google_container_cluster",
      "archetype": "container",
      "field_map": {
        "service_type": "container"
      },
      "notes": "GKE is a container orchestration platform. Archetype is 'container' (not 'kubernetes') — K8s preference is a signal for RESOLVE, not a different workload type."
    },
    {
      "source_type": "google_container_node_pool",
      "archetype": "container-node-group",
      "parent_ref": {
        "parent_type": "google_container_cluster",
        "skip_mapping_when_parent_target": ["Fargate"],
        "continue_mapping_when_parent_target": ["EKS", "EC2"]
      },
      "field_map": {
        "service_type": "vm",
        "vcpu": {
          "from": "machine_type",
          "transform": { "__gcp_machine_type__": "vcpu" }
        },
        "memory_gb": {
          "from": "machine_type",
          "transform": { "__gcp_machine_type__": "memory_gb" }
        },
        "gpu": { "from": "guest_accelerator", "transform": { "present": true, "absent": false } },
        "min_nodes": { "from": ["autoscaling.min_node_count", "autoscaling_min"], "transform": {} },
        "max_nodes": { "from": ["autoscaling.max_node_count", "autoscaling_max"], "transform": {} }
      },
      "notes": "Node pool sizing depends on parent cluster's AWS target. Fargate manages compute (skip). EKS/EC2 need explicit node group sizing."
    },
    {
      "source_type": "google_firestore_database",
      "archetype": "nosql-document",
      "field_map": {
        "service_type": "nosql-document"
      }
    },
    {
      "source_type": "google_compute_forwarding_rule",
      "archetype": "load-balancer",
      "field_map": {
        "protocol": {
          "from": "ip_protocol",
          "transform": { "TCP": "TCP", "UDP": "UDP" }
        },
        "scheme": {
          "from": "load_balancing_scheme",
          "transform": { "EXTERNAL": "EXTERNAL", "INTERNAL": "INTERNAL" }
        },
        "port_range": { "from": "port_range", "transform": {} }
      },
      "notes": "Protocol determines ALB vs NLB. HTTP/HTTPS inferred by LLM from port_range (80/443) + backend type when ip_protocol is TCP."
    },
    {
      "source_type": "google_pubsub_topic",
      "archetype": "message-broker",
      "field_map": {
        "ordering_required": {
          "from": "message_storage_policy.allowed_persistence_regions",
          "transform": {}
        }
      },
      "notes": "Pub/Sub topic. Delivery pattern (fan-out vs point-to-point) and subscriber_count inferred by LLM from subscription count in inventory."
    },
    {
      "source_type": "google_pubsub_subscription",
      "archetype": "message-broker",
      "field_map": {
        "ack_deadline_seconds": { "from": "ack_deadline_seconds", "transform": {} },
        "ordering_required": {
          "from": "enable_message_ordering",
          "transform": { "true": true, "false": false }
        }
      },
      "notes": "Pub/Sub subscription. Maps to SQS queue visibility timeout. Multiple subscriptions on same topic → fan-out pattern."
    }
  ]
}
