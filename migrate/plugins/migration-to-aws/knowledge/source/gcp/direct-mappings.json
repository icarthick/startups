{
  "kind": "direct-mappings",
  "scope": "source:gcp",
  "version": "1",
  "description": "GCP Terraform resource types with unconditional 1:1 AWS mappings. No eliminator or preference can flip these targets. Compute resources (Cloud Run, Cloud Functions, Compute Engine, GKE, App Engine) are NOT here — they all have eliminators and go through recommend_compute tool.",
  "last_verified": "2026-06-24",
  "source_url": "https://github.com/awslabs/startups/blob/main/migrate/plugins/migration-to-aws/skills/gcp-to-aws/references/design-refs/fast-path.md",
  "entries": [
    {
      "source_type": "google_storage_bucket",
      "condition": "always",
      "aws_service": "S3",
      "confidence": "deterministic",
      "notes": "1:1 mapping; preserve ACL/versioning/lifecycle rules"
    },
    {
      "source_type": "google_compute_network",
      "condition": "always",
      "aws_service": "VPC",
      "confidence": "deterministic",
      "notes": "1:1; preserve CIDR ranges"
    },
    {
      "source_type": "google_compute_subnetwork",
      "condition": "always",
      "aws_service": "Subnet",
      "confidence": "deterministic",
      "notes": "1:1; preserve CIDR range and region → AZ mapping"
    },
    {
      "source_type": "google_compute_firewall",
      "condition": "always",
      "aws_service": "Security Group",
      "confidence": "deterministic",
      "notes": "1:1 rule mapping; adjust CIDR if needed"
    },
    {
      "source_type": "google_dns_managed_zone",
      "condition": "always",
      "aws_service": "Route 53 Hosted Zone",
      "confidence": "deterministic",
      "notes": "Preserve zone name and records"
    },
    {
      "source_type": "google_service_account",
      "condition": "always",
      "aws_service": "IAM Role",
      "confidence": "deterministic",
      "notes": "Map permissions directly; adjust service principals"
    },
    {
      "source_type": "google_secret_manager_secret",
      "condition": "always",
      "aws_service": "Secrets Manager",
      "confidence": "deterministic",
      "notes": "Create secret metadata and IAM-scoped access"
    },
    {
      "source_type": "google_secret_manager_secret_version",
      "condition": "always",
      "aws_service": "Secrets Manager",
      "confidence": "deterministic",
      "notes": "Carry current value or explicit migration TODO"
    },
    {
      "source_type": "google_redis_instance",
      "condition": "always",
      "aws_service": "ElastiCache Redis",
      "confidence": "deterministic",
      "notes": "1:1 mapping; preserve cluster mode and node type"
    },
    {
      "source_type": "google_sql_database_instance",
      "condition": { "engine": "sqlserver" },
      "aws_service": "RDS SQL Server",
      "confidence": "deterministic",
      "notes": "SQL Server is always RDS (no Aurora option, no eliminator can flip it). Postgres/MySQL use recommend_database tool."
    },
    {
      "source_type": "google_filestore_instance",
      "condition": "always",
      "aws_service": "EFS",
      "confidence": "deterministic",
      "notes": "1:1 managed NFS; preserve tier/capacity in sizing"
    },
    {
      "source_type": "google_compute_security_policy",
      "condition": "always",
      "aws_service": "AWS WAF",
      "confidence": "deterministic",
      "notes": "Cloud Armor → WAF; migrate rules as WAF ACL rules"
    },
    {
      "source_type": "google_cloud_tasks_queue",
      "condition": "always",
      "aws_service": "SQS",
      "confidence": "deterministic",
      "notes": "Cloud Tasks → SQS; preserve retry/rate config as queue attributes"
    }
  ]
}
