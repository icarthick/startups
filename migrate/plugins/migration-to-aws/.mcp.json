{
  "mcpServers": {
    "awsknowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "awspricing": {
      "command": "uvx",
      "args": [
        "awslabs.aws-pricing-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "us-east-1"
      },
      "timeout": 120000,
      "type": "stdio",
      "autoApprove": [
        "get_pricing_service_codes",
        "get_pricing_service_attributes",
        "get_pricing_attribute_values",
        "get_pricing"
      ]
    },
    "migration-knowledge": {
      "command": "python3",
      "args": [
        "-m",
        "migration_knowledge.server"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "PYTHONPATH": "/Users/carthick/dev/github/startups/migrate/plugins/migration-to-aws/mcp-servers/migration-knowledge/src",
        "MIGRATION_KNOWLEDGE_DIR": "/Users/carthick/dev/github/startups/migrate/plugins/migration-to-aws/mcp-servers/migration-knowledge/knowledge"
      },
      "timeout": 30000,
      "type": "stdio",
      "autoApprove": [
        "lookup_direct_mapping",
        "normalize_resource",
        "recommend_database",
        "recommend_compute",
        "recommend_networking",
        "recommend_messaging",
        "validate_design"
      ]
    },
    "migration-plugin": {
      "command": "python3",
      "args": [
        "-m",
        "migration_orchestrator.server"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "PYTHONPATH": "/Users/carthick/dev/github/startups/migrate/plugins/migration-to-aws/mcp-servers/migration-plugin/src",
        "MIGRATION_ORCHESTRATOR_KNOWLEDGE_DIR": "/Users/carthick/dev/github/startups/migrate/plugins/migration-to-aws/mcp-servers/migration-plugin/knowledge"
      },
      "timeout": 30000,
      "type": "stdio",
      "autoApprove": [
        "migration_status",
        "migration_init",
        "phase_router",
        "phase_advance",
        "phase_reset",
        "detect_ai_signals",
        "scan_tf_references",
        "cluster_terraform",
        "create_ai_profile_from_iac"
      ]
    }
  }
}
