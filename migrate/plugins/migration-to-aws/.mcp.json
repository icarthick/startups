{
  "mcpServers": {
    "awsknowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "awspricing": {
      "command": "uvx",
      "args": [
        "awslabs.aws-pricing-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "us-east-1"
      },
      "timeout": 120000,
      "type": "stdio",
      "autoApprove": [
        "get_pricing_service_codes",
        "get_pricing_service_attributes",
        "get_pricing_attribute_values",
        "get_pricing"
      ]
    },
    "migration-tools": {
      "command": "python3",
      "args": [
        "-m",
        "migration_tools.server"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "PYTHONPATH": "/Users/carthick/dev/github/startups/migrate/plugins/migration-to-aws/server/src",
        "MIGRATION_TOOLS_KNOWLEDGE_DIR": "/Users/carthick/dev/github/startups/migrate/plugins/migration-to-aws/knowledge"
      },
      "timeout": 30000,
      "type": "stdio",
      "autoApprove": [
        "lookup_direct_mapping",
        "normalize_resource",
        "recommend_database",
        "recommend_compute",
        "validate_design"
      ]
    }
  }
}
