{
  "mcpServers": {
    "awsknowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "awspricing": {
      "command": "uvx",
      "args": [
        "awslabs.aws-pricing-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "us-east-1"
      },
      "timeout": 120000,
      "type": "stdio",
      "autoApprove": [
        "get_pricing_service_codes",
        "get_pricing_service_attributes",
        "get_pricing_attribute_values",
        "get_pricing"
      ]
    },
    "migration-knowledge": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/icarthick/startups.git@feat/migration-mcp-tools#subdirectory=migrate/mcp-servers/migration-knowledge",
        "migration-knowledge-server"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 30000,
      "type": "stdio",
      "autoApprove": [
        "lookup_direct_mapping",
        "normalize_resource",
        "recommend_database",
        "recommend_compute",
        "recommend_networking",
        "recommend_messaging",
        "recommend_bedrock_model",
        "validate_design"
      ]
    },
    "migration-plugin": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/icarthick/startups.git@feat/migration-mcp-tools#subdirectory=migrate/mcp-servers/migration-plugin",
        "migration-plugin-server"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 30000,
      "type": "stdio",
      "autoApprove": [
        "migration_status",
        "migration_init",
        "phase_router",
        "phase_advance",
        "phase_reset",
        "detect_ai_signals",
        "scan_tf_references",
        "cluster_terraform",
        "create_ai_profile_from_iac",
        "extract_billing_summary",
        "scan_app_code",
        "generate_migration_preview",
        "resolve_design_refs"
      ]
    }
  }
}
