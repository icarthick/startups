{
  "mcpServers": {
    "awsknowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "awspricing": {
      "command": "uvx",
      "args": [
        "awslabs.aws-pricing-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "us-east-1"
      },
      "timeout": 120000,
      "type": "stdio",
      "autoApprove": [
        "get_pricing_service_codes",
        "get_pricing_service_attributes",
        "get_pricing_attribute_values",
        "get_pricing"
      ]
    },
    "engine": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/icarthick/startups.git@feat/heroku-mcp-refactor#subdirectory=migrate/mcp-servers/engine",
        "engine-server"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 30000,
      "type": "stdio",
      "autoApprove": [
        "migration_status",
        "migration_init",
        "phase_router",
        "phase_advance",
        "phase_reset",
        "scan_heroku_terraform",
        "extract_heroku_billing",
        "assemble_heroku_inventory",
        "design_heroku_migration",
        "estimate_heroku_migration",
        "generate_terraform",
        "generate_docs"
      ]
    }
  }
}
