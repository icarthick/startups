{
  "mcpServers": {
    "awspricingfree": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Volumes/workplace/AWSPricingMCP/dist/mcp/server.js"
      ],
      "env": {
        "PRICING_MCP_LOG_FILE": "/Volumes/workplace/AWSPricingMCP/server.log",
        "PRICING_MCP_LOG_LEVEL": "debug"
      },
      "timeout": 120000,
      "autoApprove": [
        "resolve_service",
        "list_services",
        "describe_service",
        "price"
      ]
    },
    "awsknowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "awspricing": {
      "command": "uvx",
      "args": [
        "awslabs.aws-pricing-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "us-east-1"
      },
      "timeout": 120000,
      "type": "stdio",
      "autoApprove": [
        "get_pricing_service_codes",
        "get_pricing_service_attributes",
        "get_pricing_attribute_values",
        "get_pricing"
      ]
    }
  }
}
