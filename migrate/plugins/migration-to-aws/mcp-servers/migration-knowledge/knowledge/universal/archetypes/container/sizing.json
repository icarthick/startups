{
  "archetype": "container",
  "description": "Per-service sizing rules. CONFIGURE stage uses the resolved service to look up sizing logic here.",
  "fargate": {
    "valid_combos": [
      { "cpu": 0.25, "memory_min_gb": 0.5, "memory_max_gb": 2 },
      { "cpu": 0.5, "memory_min_gb": 1, "memory_max_gb": 4 },
      { "cpu": 1, "memory_min_gb": 2, "memory_max_gb": 8 },
      { "cpu": 2, "memory_min_gb": 4, "memory_max_gb": 16 },
      { "cpu": 4, "memory_min_gb": 8, "memory_max_gb": 30 },
      { "cpu": 8, "memory_min_gb": 16, "memory_max_gb": 60 },
      { "cpu": 16, "memory_min_gb": 32, "memory_max_gb": 120 }
    ]
  },
  "ec2": {
    "instance_mapping": [
      { "vcpu_max": 2, "memory_max_gb": 4, "instance_type": "t3.medium", "notes": "Dev/light workload" },
      { "vcpu_max": 2, "memory_max_gb": 8, "instance_type": "t3.large", "notes": "Dev/moderate" },
      { "vcpu_max": 4, "memory_max_gb": 16, "instance_type": "m5.xlarge", "notes": "Production" },
      { "vcpu_max": 8, "memory_max_gb": 32, "instance_type": "m5.2xlarge", "notes": "Production" },
      { "vcpu_max": 16, "memory_max_gb": 64, "instance_type": "m5.4xlarge", "notes": "Heavy production" },
      { "vcpu_max": 64, "memory_max_gb": 256, "instance_type": "m5.16xlarge", "notes": "Very large" }
    ],
    "gpu_instance_mapping": [
      { "gpu_max": 1, "vcpu_max": 4, "memory_max_gb": 16, "instance_type": "g5.xlarge", "notes": "1× NVIDIA A10G" },
      { "gpu_max": 1, "vcpu_max": 8, "memory_max_gb": 32, "instance_type": "g5.2xlarge", "notes": "1× NVIDIA A10G" },
      { "gpu_max": 4, "vcpu_max": 48, "memory_max_gb": 192, "instance_type": "g5.12xlarge", "notes": "4× NVIDIA A10G" },
      { "gpu_max": 4, "vcpu_max": 32, "memory_max_gb": 244, "instance_type": "p3.8xlarge", "notes": "4× NVIDIA V100" },
      { "gpu_max": 8, "vcpu_max": 64, "memory_max_gb": 488, "instance_type": "p3.16xlarge", "notes": "8× NVIDIA V100" },
      { "gpu_max": 8, "vcpu_max": 96, "memory_max_gb": 1152, "instance_type": "p4d.24xlarge", "notes": "8× NVIDIA A100" }
    ]
  },
  "lambda": {
    "memory_min_mb": 128,
    "memory_max_mb": 10240,
    "timeout_max_seconds": 900
  },
  "eks": {
    "sizing_deferred": true,
    "notes": "Node pool sizing deferred to Generate phase"
  }
}
