{
  "_comment": "Assertions for the render-to-aws basic skill design path. Covers: web_service → Elastic Beanstalk (default), background_worker → Fargate (always), postgres → RDS PostgreSQL, key_value → ElastiCache Redis. Also cross-checks the Render plan sizing tables.",
  "every_service_must_map": true,
  "expected_services": [
    {
      "source_resource_id": "render:acme-api:web",
      "render_service_type": "web_service",
      "aws_service": "Elastic Beanstalk",
      "aws_config": { "instance_type": "t3.small", "environment_type": "LoadBalanced" }
    },
    {
      "source_resource_id": "render:acme-worker:worker",
      "render_service_type": "background_worker",
      "aws_service": "Fargate",
      "aws_config": { "task_cpu": 1024, "task_memory": 2048, "desired_count": 2, "load_balancer": false }
    },
    {
      "source_resource_id": "render:acme-db:postgres",
      "render_service_type": "postgres",
      "aws_service": "RDS PostgreSQL",
      "aws_config": { "instance_class": "db.t4g.small" }
    },
    {
      "source_resource_id": "render:acme-cache:redis",
      "render_service_type": "key_value",
      "aws_service": "ElastiCache Redis",
      "aws_config": { "node_type": "cache.t4g.micro" }
    }
  ],
  "required_warning_substrings": [],
  "forbidden_warning_substrings": ["Unsupported service type", "out of scope"],
  "sizing_tables": {
    "_comment": "Cross-table regression: web services may be mapped to either EB or Fargate; background workers always use the worker-fargate table. Both Fargate tables must cover all Render plan tiers.",
    "web_eb": "skills/render-to-aws/knowledge/design/web-service-eb-sizing.json",
    "web_fargate": "skills/render-to-aws/knowledge/design/web-service-fargate-sizing.json",
    "worker_fargate": "skills/render-to-aws/knowledge/design/worker-fargate-sizing.json",
    "postgres_rds": "skills/render-to-aws/knowledge/design/postgres-rds-sizing.json",
    "redis_elasticache": "skills/render-to-aws/knowledge/design/redis-elasticache-sizing.json",
    "required_plans_in_compute_tables": ["starter", "standard", "pro"],
    "required_plans_in_data_tables": ["starter", "standard", "pro"]
  },
  "fargate_cpu_memory_matrix": {
    "_source": "https://docs.aws.amazon.com/AmazonECS/latest/developerguide/fargate-tasks-services.html — 'Task CPU and memory' (verified 2026-09-19). Fargate rejects any other pairing at RunTask time.",
    "256": { "values": [512, 1024, 2048] },
    "512": { "values": [1024, 2048, 3072, 4096] },
    "1024": { "min": 2048, "max": 8192, "step": 1024 },
    "2048": { "min": 4096, "max": 16384, "step": 1024 },
    "4096": { "min": 8192, "max": 30720, "step": 1024 },
    "8192": { "min": 16384, "max": 61440, "step": 4096 },
    "16384": { "min": 32768, "max": 122880, "step": 8192 }
  }
}
