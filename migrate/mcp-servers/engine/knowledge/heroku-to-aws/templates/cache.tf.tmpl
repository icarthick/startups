# --- REPEAT_START elasticache ---
resource "aws_elasticache_subnet_group" "{{app_sanitized}}_redis" {
  name       = "${var.project_name}-{{heroku_app}}-redis-subnet"
  subnet_ids = {{private_subnets}}
}

resource "aws_elasticache_replication_group" "{{app_sanitized}}_redis" {
  replication_group_id = "${var.project_name}-{{heroku_app}}-redis"
  description          = "Redis for {{heroku_app}} (migrated from Heroku Redis {{plan}})"

  node_type            = "{{node_type}}"
  num_cache_clusters   = {{num_nodes}}
  engine_version       = "{{engine_version}}"
  port                 = 6379

  multi_az_enabled           = {{multi_az}}
  automatic_failover_enabled = {{automatic_failover}}
  transit_encryption_enabled = {{transit_encryption}}
  at_rest_encryption_enabled = true

  subnet_group_name  = aws_elasticache_subnet_group.{{app_sanitized}}_redis.name
  security_group_ids = [aws_security_group.cache.id]

  tags = { HerokuApp = "{{heroku_app}}", Source = "heroku-redis:{{plan}}" }
}
# --- REPEAT_END elasticache ---
