resource "aws_ecs_cluster" "main" {
  name = "${var.project_name}-${var.environment}"
  setting {
    name  = "containerInsights"
    value = "enabled"
  }
  tags = { Name = "${var.project_name}-${var.environment}-cluster" }
}

# --- REPEAT_START fargate ---
resource "aws_cloudwatch_log_group" "__app_sanitized___process_type__" {
  name              = "/ecs/${var.project_name}-${var.environment}/__process_type__"
  retention_in_days = __log_retention__
  tags = { HerokuApp = "__heroku_app__", ProcessType = "__process_type__" }
}

resource "aws_ecs_task_definition" "__app_sanitized___process_type__" {
  family                   = "${var.project_name}-${var.environment}-__process_type__"
  network_mode             = "awsvpc"
  requires_compatibilities = ["FARGATE"]
  cpu                      = __task_cpu__
  memory                   = __task_memory__
  execution_role_arn       = aws_iam_role.ecs_execution.arn
  task_role_arn            = aws_iam_role.ecs_task.arn

  container_definitions = jsonencode([{
    name      = "__process_type__"
    image     = "__container_image__"
    cpu       = __task_cpu__
    memory    = __task_memory__
    essential = true
    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = aws_cloudwatch_log_group.__app_sanitized___process_type__.name
        "awslogs-region"        = var.aws_region
        "awslogs-stream-prefix" = "ecs"
      }
    }
    portMappings = __port_mappings__
  }])

  tags = { HerokuApp = "__heroku_app__", ProcessType = "__process_type__" }
}

resource "aws_ecs_service" "__app_sanitized___process_type__" {
  name            = "${var.project_name}-__process_type__"
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.__app_sanitized___process_type__.arn
  desired_count   = __desired_count__
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = __subnets__
    security_groups  = [aws_security_group.app.id]
    assign_public_ip = false
  }

  __load_balancer_block__

  tags = { HerokuApp = "__heroku_app__", ProcessType = "__process_type__" }
}
# --- REPEAT_END fargate ---

# --- REPEAT_START alb ---
resource "aws_lb" "__app_sanitized__" {
  name               = "${var.project_name}-__heroku_app__-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = __public_subnets__
  tags = { HerokuApp = "__heroku_app__" }
}

resource "aws_lb_target_group" "__app_sanitized___process_type__" {
  name        = "${var.project_name}-__process_type__-tg"
  port        = 8080
  protocol    = "HTTP"
  vpc_id      = __vpc_id__
  target_type = "ip"

  health_check {
    path                = "/health"
    healthy_threshold   = 2
    unhealthy_threshold = 3
    interval            = 30
  }
}

resource "aws_lb_listener" "__app_sanitized___https" {
  load_balancer_arn = aws_lb.__app_sanitized__.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = var.certificate_arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.__app_sanitized___process_type__.arn
  }
}
# --- REPEAT_END alb ---
