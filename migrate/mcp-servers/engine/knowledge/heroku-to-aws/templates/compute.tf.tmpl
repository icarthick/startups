resource "aws_ecs_cluster" "main" {
  name = "${var.project_name}-${var.environment}"
  setting {
    name  = "containerInsights"
    value = "enabled"
  }
  tags = { Name = "${var.project_name}-${var.environment}-cluster" }
}

# --- REPEAT_START fargate ---
resource "aws_cloudwatch_log_group" "{{app_sanitized}}_{{process_type}}" {
  name              = "/ecs/${var.project_name}-${var.environment}/{{process_type}}"
  retention_in_days = {{log_retention}}
  tags = { HerokuApp = "{{heroku_app}}", ProcessType = "{{process_type}}" }
}

resource "aws_ecs_task_definition" "{{app_sanitized}}_{{process_type}}" {
  family                   = "${var.project_name}-${var.environment}-{{process_type}}"
  network_mode             = "awsvpc"
  requires_compatibilities = ["FARGATE"]
  cpu                      = {{task_cpu}}
  memory                   = {{task_memory}}
  execution_role_arn       = aws_iam_role.ecs_execution.arn
  task_role_arn            = aws_iam_role.ecs_task.arn

  container_definitions = jsonencode([{
    name      = "{{process_type}}"
    image     = "{{container_image}}"
    cpu       = {{task_cpu}}
    memory    = {{task_memory}}
    essential = true
    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = aws_cloudwatch_log_group.{{app_sanitized}}_{{process_type}}.name
        "awslogs-region"        = var.aws_region
        "awslogs-stream-prefix" = "ecs"
      }
    }
    portMappings = {{port_mappings}}
  }])

  tags = { HerokuApp = "{{heroku_app}}", ProcessType = "{{process_type}}" }
}

resource "aws_ecs_service" "{{app_sanitized}}_{{process_type}}" {
  name            = "${var.project_name}-{{process_type}}"
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.{{app_sanitized}}_{{process_type}}.arn
  desired_count   = {{desired_count}}
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = {{subnets}}
    security_groups  = [aws_security_group.app.id]
    assign_public_ip = false
  }

  {{load_balancer_block}}

  tags = { HerokuApp = "{{heroku_app}}", ProcessType = "{{process_type}}" }
}
# --- REPEAT_END fargate ---

# --- REPEAT_START alb ---
resource "aws_lb" "{{app_sanitized}}" {
  name               = "${var.project_name}-{{heroku_app}}-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = {{public_subnets}}
  tags = { HerokuApp = "{{heroku_app}}" }
}

resource "aws_lb_target_group" "{{app_sanitized}}_{{process_type}}" {
  name        = "${var.project_name}-{{process_type}}-tg"
  port        = 8080
  protocol    = "HTTP"
  vpc_id      = {{vpc_id}}
  target_type = "ip"

  health_check {
    path                = "/health"
    healthy_threshold   = 2
    unhealthy_threshold = 3
    interval            = 30
  }
}

resource "aws_lb_listener" "{{app_sanitized}}_https" {
  load_balancer_arn = aws_lb.{{app_sanitized}}.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = var.certificate_arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.{{app_sanitized}}_{{process_type}}.arn
  }
}
# --- REPEAT_END alb ---
