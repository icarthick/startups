{
  "description": "File patterns to exclude from scanning — potential secret files",
  "patterns": [
    ".env",
    ".env.*",
    "credentials.json",
    "service-account.json",
    "*-service-account.json",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "secrets.yaml",
    "secrets.yml"
  ]
}
