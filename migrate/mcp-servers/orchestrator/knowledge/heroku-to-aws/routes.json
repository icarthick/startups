{
  "skill": "heroku-to-aws",
  "version": "1",
  "phases": ["discover", "clarify", "design", "estimate", "generate", "feedback"],
  "routes": {
    "discover": {
      "routes": [
        {
          "id": "terraform",
          "trigger": {"glob": ["**/*.tf", "**/*.tfvars"]},
          "file": "references/phases/discover/discover-terraform.md",
          "produces": ["_terraform-discovery.json"]
        },
        {
          "id": "billing",
          "trigger": {"glob": ["**/*billing*.csv", "**/*billing*.json", "**/*cost*.csv", "**/*invoice*.csv"]},
          "file": "references/phases/discover/discover-billing.md",
          "produces": ["_billing-discovery.json"]
        },
        {
          "id": "assemble",
          "trigger": {"always": true},
          "file": "references/phases/discover/discover-assemble.md",
          "produces": ["heroku-resource-inventory.json"]
        }
      ]
    },
    "clarify": {
      "requires_phase": "discover",
      "routes": [
        {
          "id": "clarify",
          "trigger": {"always": true},
          "file": "references/phases/clarify/clarify.md",
          "produces": ["preferences.json"]
        }
      ]
    },
    "design": {
      "requires_phase": "clarify",
      "routes": [
        {
          "id": "design",
          "trigger": {"artifact_exists": ["heroku-resource-inventory.json"]},
          "file": "references/phases/design/design.md",
          "produces": ["aws-design.json"]
        }
      ]
    },
    "estimate": {
      "requires_phase": "design",
      "routes": [
        {
          "id": "estimate",
          "trigger": {"artifact_exists": ["aws-design.json"]},
          "file": "references/phases/estimate/estimate.md",
          "produces": ["estimation-infra.json"]
        }
      ]
    },
    "generate": {
      "requires_phase": "estimate",
      "routes": [
        {
          "id": "terraform",
          "trigger": {"artifact_exists": ["aws-design.json"]},
          "file": "references/phases/generate/generate-terraform.md",
          "produces": ["terraform/"]
        },
        {
          "id": "docs",
          "trigger": {"artifact_exists": ["aws-design.json"]},
          "file": "references/phases/generate/generate-docs.md",
          "produces": ["MIGRATION_GUIDE.md"]
        }
      ]
    },
    "feedback": {
      "requires_phase": "generate",
      "routes": [
        {
          "id": "feedback",
          "trigger": {"always": true},
          "file": "references/phases/feedback/feedback.md",
          "produces": []
        }
      ]
    }
  }
}
